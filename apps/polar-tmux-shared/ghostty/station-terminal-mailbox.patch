+/// Resolve a live presentation on the app thread. Queued events cannot
+/// dereference an earlier Surface after it is replaced or destroyed.
+fn stationTerminalMessage(self: *App, terminal_id: u64, msg: apprt.surface.Message) !void {
+    if (self.focusedSurface()) |view| {
+        if (view.io.station_terminal_id == terminal_id and view.visible and view.focused) {
+            return view.handleMessage(msg);
+        }
+    }
+    if (msg.requiresStationFocus()) {
+        msg.discard();
+        return;
+    }
+
+    var resident: ?*Surface = null;
+    for (self.surfaces.items) |surface| {
+        const view = surface.core();
+        if (view.io.station_terminal_id != terminal_id) continue;
+        if (view.visible) return view.handleMessage(msg);
+        if (resident == null) resident = view;
+    }
+    if (resident) |view| return view.handleMessage(msg);
+    msg.discard();
+}
