+    }
+
+    pub fn deinit(self: *StationFileCapture, alloc: Allocator) void {
+        self.map.deinit(alloc);
+    }
+
+    pub fn acceptsRange(self: StationFileCapture, start: usize, end: usize) bool {
+        return start < end and end <= self.text.len and end <= self.map.map.count() and
+            !(self.cut_before and start == 0) and !(self.cut_after and end == self.text.len);
+    }
