+pub const StationFileCapture = struct {
+    const side_bytes = 2048;
+
+    text: [:0]const u8,
+    map: StringMap,
+    hit: usize,
+    cut_before: bool,
+    cut_after: bool,
+
+    const Extent = struct { pin: Pin, cut: bool };
+
+    fn cellBytes(pin: Pin) usize {
+        const cell = pin.rowAndCell().cell;
+        switch (cell.wide) {
+            .spacer_head, .spacer_tail => return 0,
+            .narrow, .wide => {},
+        }
+        if (!cell.hasText()) return 1;
+        var len: usize = std.unicode.utf8CodepointSequenceLength(cell.codepoint()) catch 4;
+        if (pin.grapheme(cell)) |extra| {
+            for (extra) |cp| {
+                len += std.unicode.utf8CodepointSequenceLength(cp) catch 4;
+                if (len > side_bytes) break;
+            }
+        }
+        return len;
+    }
+
+    fn blankHardRow(pin: Pin) bool {
+        const row = pin.rowAndCell().row;
+        if (row.wrap or row.wrap_continuation) return false;
+        for (pin.cells(.all)) |*cell| {
+            switch (cell.codepoint()) {
+                0, ' ', '\t' => if (cell.content_tag == .codepoint_grapheme) return false,
+                else => return false,
+            }
+        }
+        return true;
+    }
+
+    fn extent(hit: Pin, edge: Pin, comptime forward: bool, available: usize) Extent {
+        var remaining = available;
+        var current = hit;
+        var included = hit;
+        const semantic = hit.rowAndCell().cell.semantic_content;
+        while (!current.eql(edge)) {
+            const next = (if (forward) current.rightWrap(1) else current.leftWrap(1)) orelse break;
+            const next_semantic = next.rowAndCell().cell.semantic_content;
+            // OSC 133 separates the actual shell prompt from input and output.
+            if (semantic != next_semantic and (semantic == .prompt or next_semantic == .prompt))
+                return .{ .pin = included, .cut = false };
+            const new_row = next.node != current.node or next.y != current.y;
+            if (new_row and blankHardRow(next)) return .{ .pin = included, .cut = false };
+            const bytes = cellBytes(next);
+            // Reserve a byte for the formatter's newline at a row transition.
+            // A soft wrap often needs zero bytes, even across Ghostty pages.
+            const newline: usize = @intFromBool(new_row);
+            if (bytes + newline > remaining) return .{ .pin = included, .cut = true };
+            remaining -= bytes + newline;
+            current = next;
+            // Starting a formatter selection on a wide tail would pull in its
+            // unbudgeted lead. Keep only endpoints of whole cells.
+            if (bytes != 0) included = next;
+        }
+        const row = current.rowAndCell().row;
+        return .{ .pin = included, .cut = if (forward) row.wrap else row.wrap_continuation };
+    }
+
+    pub fn init(screen: *Screen, alloc: Allocator, click: Pin) Allocator.Error!?StationFileCapture {
+        if (screen.pages.pointFromPin(.viewport, click) == null) return null;
+        var hit_pin = click;
+        if (click.rowAndCell().cell.wide == .spacer_tail) hit_pin.x -|= 1;
+        const hit_bytes = cellBytes(hit_pin);
+        if (hit_bytes == 0 or hit_bytes > side_bytes) return null;
+        const top = screen.pages.getTopLeft(.viewport);
+        const bottom = screen.pages.getBottomRight(.viewport) orelse return null;
+        const left = extent(hit_pin, top, false, side_bytes);
+        const right = extent(hit_pin, bottom, true, side_bytes - hit_bytes);
+        var map = try screen.selectionStringMap(alloc, .{
+            .sel = Selection.init(left.pin, right.pin, false),
+            .trim = false,
+        });
+        const text = map.string;
+        const offset = for (0..map.map.count()) |index| {
+            const mapped = map.map.get(index) orelse continue;
+            if (mapped.eql(hit_pin)) break index;
