[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.3"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://native/libpolar_graphics_godot.so"
linux.release.x86_64 = "res://native/libpolar_graphics_godot.so"
macos.debug = "res://native/libpolar_graphics_godot.dylib"
macos.release = "res://native/libpolar_graphics_godot.dylib"
windows.debug.x86_64 = "res://native/polar_graphics_godot.dll"
windows.release.x86_64 = "res://native/polar_graphics_godot.dll"

