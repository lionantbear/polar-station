<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.10"/>
  <requires lib="Adw" version="1.4"/>
  <object class="AdwApplicationWindow" id="main_window">
    <property name="title">Polar Tmux</property>
    <property name="default-width">1080</property>
    <property name="default-height">680</property>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
                <property name="title">Polar Tmux</property>
                <property name="subtitle">Sessions stay in tmux when this window closes</property>
              </object>
            </property>
            <child type="start">
              <object class="GtkDropDown" id="target_dropdown">
                <property name="tooltip-text">Execution target</property>
                <accessibility>
                  <property name="label">Execution target</property>
                </accessibility>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="refresh_button">
                <property name="icon-name">view-refresh-symbolic</property>
                <property name="tooltip-text">Refresh snapshot</property>
                <accessibility>
                  <property name="label">Refresh snapshot</property>
                </accessibility>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkStack" id="state_stack">
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <property name="transition-type">crossfade</property>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">loading</property>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <property name="halign">center</property>
                        <property name="valign">center</property>
                        <child>
                          <object class="GtkSpinner">
                            <property name="spinning">true</property>
                            <property name="width-request">32</property>
                            <property name="height-request">32</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">Loading tmux state…</property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">empty</property>
                    <property name="child">
                      <object class="AdwStatusPage">
                        <property name="icon-name">utilities-terminal-symbolic</property>
                        <property name="title">No tmux sessions</property>
                        <property name="description">This target has no sessions to display.</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">offline</property>
                    <property name="child">
                      <object class="AdwStatusPage">
                        <property name="icon-name">network-offline-symbolic</property>
                        <property name="title">Host offline</property>
                        <property name="description">Waiting for the local Polar Tmux Host connection.</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">error</property>
                    <property name="child">
                      <object class="AdwStatusPage" id="error_page">
                        <property name="icon-name">dialog-error-symbolic</property>
                        <property name="title">Snapshot unavailable</property>
                        <property name="description">The Host request failed.</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">populated</property>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">1</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <child>
                          <object class="GtkBox" id="session_panel">
                            <property name="orientation">vertical</property>
                            <property name="hexpand">true</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Sessions</property>
                                <property name="xalign">0</property>
                                <property name="margin-start">12</property>
                                <property name="margin-bottom">8</property>
                                <style><class name="title-3"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkScrolledWindow">
                                <property name="vexpand">true</property>
                                <property name="hscrollbar-policy">never</property>
                                <property name="child">
                                  <object class="GtkListBox" id="session_list">
                                    <property name="selection-mode">single</property>
                                    <style><class name="boxed-list"/></style>
                                    <accessibility>
                                      <property name="label">Tmux sessions</property>
                                    </accessibility>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSeparator">
                            <property name="orientation">vertical</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="window_panel">
                            <property name="orientation">vertical</property>
                            <property name="hexpand">true</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Windows</property>
                                <property name="xalign">0</property>
                                <property name="margin-start">12</property>
                                <property name="margin-bottom">8</property>
                                <style><class name="title-3"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkScrolledWindow">
                                <property name="vexpand">true</property>
                                <property name="hscrollbar-policy">never</property>
                                <property name="child">
                                  <object class="GtkListBox" id="window_list">
                                    <property name="selection-mode">single</property>
                                    <style><class name="boxed-list"/></style>
                                    <accessibility>
                                      <property name="label">Tmux windows</property>
                                    </accessibility>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSeparator">
                            <property name="orientation">vertical</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="pane_panel">
                            <property name="orientation">vertical</property>
                            <property name="hexpand">true</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Panes</property>
                                <property name="xalign">0</property>
                                <property name="margin-start">12</property>
                                <property name="margin-bottom">8</property>
                                <style><class name="title-3"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkScrolledWindow">
                                <property name="vexpand">true</property>
                                <property name="hscrollbar-policy">never</property>
                                <property name="child">
                                  <object class="GtkListBox" id="pane_list">
                                    <property name="selection-mode">single</property>
                                    <style><class name="boxed-list"/></style>
                                    <accessibility>
                                      <property name="label">Tmux panes</property>
                                    </accessibility>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkSeparator"/>
            </child>
            <child>
              <object class="GtkLabel" id="status_label">
                <property name="label">Local frontend</property>
                <property name="xalign">0</property>
                <property name="ellipsize">end</property>
                <property name="margin-top">8</property>
                <property name="margin-bottom">8</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <style><class name="dim-label"/></style>
                <accessibility>
                  <property name="label">Connection status</property>
                </accessibility>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
