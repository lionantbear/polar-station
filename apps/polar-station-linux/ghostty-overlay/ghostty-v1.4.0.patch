 pub const GlobalShortcuts = extern struct {
     const Self = @This();
+
+    // Older GNOME portals advertise ConfigureShortcuts but reject the call.
+    // Reuse the desktop's per-app shortcut editor; it owns persistence/conflicts.
+    fn openStationShortcutSettings(err: ?*glib.Error) bool {
+        if (err) |value| {
+            const remote = gio.DBusError.getRemoteError(value) orelse return false;
+            defer glib.free(remote);
+            const name = std.mem.span(remote);
+            if (!std.mem.eql(u8, name, "org.freedesktop.DBus.Error.UnknownMethod") and
+                !std.mem.eql(u8, name, "org.freedesktop.DBus.Error.NotSupported")) return false;
+        }
+        const desktop = glib.getenv("XDG_CURRENT_DESKTOP") orelse return false;
+        var names = std.mem.tokenizeScalar(u8, std.mem.span(desktop), ':');
+        var gnome = false;
+        while (names.next()) |part| {
+            if (std.mem.eql(u8, part, "GNOME")) gnome = true;
+        }
+        if (!gnome) return false;
+        var launch_error: ?*glib.Error = null;
+        defer if (launch_error) |value| value.free();
+        // Constant argv parsed by GLib; no shell or user-supplied interpolation.
+        if (glib.spawnCommandLineAsync("gnome-control-center applications com.polarealm.PolarStation", &launch_error) == 0) return false;
+        station_main.dictateVoiceSettingError("System settings opened: select Global Shortcuts, then Hold to Dictate.");
+        return true;
+    }
+
+    pub fn configureStation(self: *Self) bool {
+        const priv = self.private();
+        const dbus = priv.dbus_connection orelse return Self.openStationShortcutSettings(null);
+        const handle = priv.handle orelse return Self.openStationShortcutSettings(null);
+        const payload = glib.Variant.newParsed("(%o, '', @a{sv} {})", handle.ptr);
+        const callbacks = struct {
+            fn completed(source: ?*gobject.Object, result: *gio.AsyncResult, _: ?*anyopaque) callconv(.c) void {
+                const connection = gobject.ext.cast(gio.DBusConnection, source.?).?;
+                var err: ?*glib.Error = null;
+                defer if (err) |value| value.free();
+                const reply = connection.callFinish(result, &err) orelse {
+                    if (err) |value| {
+                        if (Self.openStationShortcutSettings(value)) return;
+                        log.warn("Dictate shortcut configuration failed: {s}", .{value.f_message orelse "unknown error"});
+                    }
+                    station_main.dictateVoiceSettingError("Could not open system shortcut settings. Open your desktop settings and select Polar Station global shortcuts.");
+                    return;
+                };
+                reply.unref();
+            }
+        };
+        dbus.call("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
+            "org.freedesktop.portal.GlobalShortcuts", "ConfigureShortcuts", payload, null, .{},
+            10000, null, callbacks.completed, null);
+        return true;
+    }
