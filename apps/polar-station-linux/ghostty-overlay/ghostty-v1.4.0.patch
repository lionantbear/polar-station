+        .target = cfg.target,
+        .optimize = cfg.optimize,
+    });
+    try translate_c.addImportToModule(b, "polar_station_display_c", module, .{
+        .source = .{ .file = b.path("src/apprt/gtk/polar_tmux/station_display.h") },
+        .target = cfg.target,
+        .optimize = cfg.optimize,
+    });
+    const client_archive = b.pathJoin(&.{ cfg.polar_station_client_lib_dir.?, "libpolar_station_desktop_ffi.a" });
+    module.addObjectFile(.{ .cwd_relative = client_archive });
+    module.linkSystemLibrary("dl", .{});
+    module.linkSystemLibrary("pthread", .{});
+    module.linkSystemLibrary("m", .{});
+    module.linkSystemLibrary("ssl", .{});
+    module.linkSystemLibrary("crypto", .{});
+    // Rust libwebm uses the native C++ ABI; Zig's libc++ is not a substitute.
+    const cxx = b.findProgram(.{ .names = &.{"c++", "g++"} }) orelse return error.CxxCompilerNotFound;
+    const cxx_runtime = std.mem.trim(u8, b.run(&.{cxx, "-print-file-name=libstdc++.so"}), " \r\n");
+    module.addObjectFile(.{ .cwd_relative = cxx_runtime });
+}
