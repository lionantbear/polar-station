+        const priv = self.private();
+        if (priv.shortcut_pressed_keycode == keycode) priv.shortcut_pressed_keycode = 0;
+        priv.shortcut_modifiers.release(keyval);
+        if (priv.shortcut_hud) |hud|
+            hud.setVisible(@intFromBool(priv.shortcut_modifiers.visible()));
+        polar_tmux.setNumberBadgesVisible(self, priv.shortcut_modifiers.visible());
