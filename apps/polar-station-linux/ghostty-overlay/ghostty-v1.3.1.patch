+    ) callconv(.c) c_int {
+        const priv = self.private();
+        priv.shortcut_modifiers.press(keyval, mods);
+        const visible = priv.shortcut_modifiers.visible();
+        if (priv.shortcut_hud) |hud| {
+            if(visible) self.rebuildShortcutHud();
+            hud.setVisible(@intFromBool(visible));
+        }
+        polar_tmux.setNumberBadgesVisible(self, visible);
+        if (!visible) return 0;
+        const action = polar_shortcuts.resolve(keyval, keycode) orelse return 0;
+        if (priv.shortcut_pressed_keycode == keycode and !polar_shortcuts.repeatable(keyval, keycode)) return 1;
+        if (!polar_tmux.dispatchWindowShortcut(self, action)) return 0;
+        priv.shortcut_pressed_keycode = keycode;
+        self.rebuildShortcutHud();
+        return 1;
+    }
