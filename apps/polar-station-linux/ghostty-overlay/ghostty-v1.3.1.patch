+    pub const ManagedFontSync = enum {
+        synchronized,
+        pending_realization,
+    };
+
+    /// Synchronizes one managed Polar Station Surface without depending on
+    /// GTK realization timing. Unrealized Surfaces retain the request that
+    /// initSurface consumes; realized Surfaces use Ghostty's normal action.
+    pub fn synchronizeManagedFontSize(
+        self: *Self,
+        points: f32,
+    ) !ManagedFontSync {
+        const priv = self.private();
+        if (priv.core_surface) |surface| {
+            if (surface.font_size.points != points or
+                !surface.font_size_adjusted)
+            {
+                _ = try surface.performBindingAction(
+                    .{ .set_font_size = points },
+                );
+            }
+            return .synchronized;
+        }
+
+        if (priv.font_size_request) |size| {
+            size.points = points;
+        } else {
+            const size = glib.ext.create(font.face.DesiredSize);
+            size.* = .{ .points = points };
+            priv.font_size_request = size;
+        }
+        self.as(gobject.Object).notifyByPspec(
+            properties.@"font-size-request".impl.param_spec,
+        );
+        return .pending_realization;
+    }
