+    fn rebuildShortcutHud(self:*Self) void {
+        const hud=self.private().shortcut_hud orelse return;
+        const columns:*gtk.Box=@ptrCast(@alignCast(hud.as(gobject.Object).getData("polar-shortcut-columns") orelse return));
+        while(columns.as(gtk.Widget).getFirstChild())|child|columns.remove(child);
+        const context=polar_tmux.shortcutHintContext(self);
+        const column_count:usize=if(self.as(gtk.Widget).getWidth()>=1050) 2 else 1;
+        const capacity:usize=@intCast(@max(1,@divTrunc(self.as(gtk.Widget).getHeight()-150,82)));
+        const count=@min(polar_shortcuts.hintCount(context),capacity*column_count);
+        const rows=@max(1,@min(capacity,(count+column_count-1)/column_count));
+        var column:?*gtk.Box=null;
+        for(0..count)|index|{
+            if(index%rows==0){column=gtk.Box.new(.vertical,0);column.?.as(gtk.Widget).setHexpand(1);columns.append(column.?.as(gtk.Widget));}
+            const entry=polar_shortcuts.hintEntry(context,index);
+            appendShortcutRow(column.?,std.mem.span(entry.key),std.mem.span(entry.label));
+        }
+    }
