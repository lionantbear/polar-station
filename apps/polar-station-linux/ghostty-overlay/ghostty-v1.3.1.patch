diff --git a/src/polar_station_trace.zig b/src/polar_station_trace.zig
new file mode 100644
--- /dev/null
+++ b/src/polar_station_trace.zig
@@ -0,0 +0,53 @@
+//! Bounded opt-in milestones and actual invocation diagnostics.
+const std = @import("std");
+pub const managed = @import("build_options").polar_tmux;
+var sequence = std.atomic.Value(u64).init(1);
+var trace_enabled = std.atomic.Value(u8).init(0);
+extern fn polar_station_trace_native(u32, ?[*]const u8, usize, u64) callconv(.c) void;
+extern fn polar_station_trace_native_call(u32, u64, u64) callconv(.c) void;
+pub fn enabled() bool {
+    if (comptime !managed) return false;
+    const cached = trace_enabled.load(.monotonic);
+    if (cached != 0) return cached == 2;
+    const value: u8 = if (std.posix.getenv("POLAR_STATION_TRACE_DIR") != null) 2 else 1;
+    trace_enabled.store(value, .monotonic);
+    return value == 2;
+}
+pub fn beginCall(stage: u32, key: u64) u64 {
+    if (!enabled()) return 0;
+    const operation = nextKey();
+    endCall(stage, key, operation);
+    return operation;
+}
+pub fn endCall(stage: u32, key: u64, operation: u64) void {
+    if (comptime managed) {
+        if (operation != 0) polar_station_trace_native_call(stage, key, operation);
+    }
+}
+pub fn nextKey() u64 { return sequence.fetchAdd(1, .monotonic); }
+pub fn emit(stage: u32, key: u64) void {
+    if (comptime managed) {
+        if (key != 0) polar_station_trace_native(stage, null, 0, key);
+    }
+}
+pub fn rendererKey(renderer: anytype) u64 {
+    if (!enabled()) return 0;
+    renderer.draw_mutex.lock();
+    defer renderer.draw_mutex.unlock();
+    return renderer.polar_trace_key;
+}
+
+// Read the existing shared diagnostic identity under its existing owner lock.
+pub fn stateKey(state: anytype) u64 {
+    if (!enabled()) return 0;
+    state.mutex.lock();
+    defer state.mutex.unlock();
+    return state.polar_trace_key;
+}
+
+extern fn polar_station_trace_native_grid(u32, u64, u32, u32, u32, u32) callconv(.c) void;
+pub fn grid(stage: u32, key: u64, columns: u32, rows: u32, width: u32, height: u32) void {
+    if (comptime managed) {
+        if (enabled()) polar_station_trace_native_grid(stage, key, columns, rows, width, height);
+    }
+}
