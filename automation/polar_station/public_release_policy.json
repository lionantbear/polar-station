{
  "schema_version": 1,
  "product": "polar-station",
  "cargo_seed_packages": [
    "polar-tmux",
    "polar-graphics-godot",
    "polar-graphics-package",
    "polar-force-layout-core"
  ],
  "native_source_roots": [
    "apps/polar-station-macos",
    "apps/polar-station-linux",
    "apps/polar-tmux-shared",
    "apps/polar-graphics-native",
    "apps/polar-ideacave-godot"
  ],
  "production_build_inputs": [
    "automation/polar_station/apply_display_overlay.py",
    "automation/polar_station/native_action_overlay.py",
    "automation/polar_station/theme_resources.py",
    "automation/polar_station/graphics_resources.py",
    "automation/polar_station/graphics_macos.py",
    "automation/polar_station/build_macos.sh",
    "automation/polar_station/build_macos_graphics.sh",
    "automation/polar_station/build_linux_ghostty.sh",
    "automation/polar_station/build_linux_graphics.sh",
    "automation/polar_station/install_linux.sh",
    "automation/polar_station/install_macos.sh",
    "automation/polar_station/gnome_shortcuts.py",
    "automation/polar_station/host-macos.entitlements",
    "automation/polar_station/host-macos-info.plist",
    "automation/polar_station/toolchain_wrappers/xcrun",
    "automation/polar_station/public_release.py",
    "automation/polar_station/public_release_policy.json",
    "automation/polar_station/public_profile.py",
    "automation/polar_station/license_audit.py",
    "automation/polar_station/license_policy.json",
    "automation/polar_station/macos_binary_inventory.py",
    "automation/polar_station/package_macos_free.sh",
    "automation/polar_station/public_test_cleanup.json",
    "automation/polar_station/collect_cargo_licenses.py",
    "automation/polar_station/fetch_cargo_legal_texts.py",
    "automation/polar_station/verify_cargo_archives.py",
    "automation/polar_station/first_party_licensing.json",
    "automation/polar_station/build_rust_runtime.py",
    "automation/polar_station/public_native_cleanup.json",
    "automation/polar_station/source_hygiene.py",
    "automation/polar_station/public_sync.py",
    "automation/polar_station/collect_macos_build_evidence.py",
    "automation/polar_station/record_macos_signing.py",
    "automation/polar_station/write_macos_release_gate.py",
    "automation/polar_station/public_build_cleanup.json",
    "automation/polar_station/public_source_identity.py",
    "automation/polar_station/source_cleanup.py",
    "automation/polar_station/source_structural.py",
    "automation/polar_station/source-tools-requirements.txt",
    "automation/polar_station/source_manifest.py",
    "automation/polar_station/sign_trial_main.py",
    "automation/polar_station/capture_native_source.py"
  ],
  "root_inputs": [
    "Cargo.lock",
    "rust-toolchain.toml",
    "itrees/polar-browsing.itree.json"
  ],
  "ignored_directory_names": [
    ".git",
    ".agents",
    "target",
    "tests",
    "__pycache__",
    "benches",
    "benchmarks",
    "evidence",
    "history",
    "handoff",
    "test-fixtures"
  ],
  "ignored_suffixes": [
    ".pyc",
    ".log",
    ".profraw",
    ".profdata",
    ".gcda",
    ".gcno"
  ],
  "blocked_path_fragments": [
    "/hear-crypto/firmware/",
    "/polar-hear-private/",
    "/polar-hear-archive/",
    "/hardware-crypto-private/"
  ],
  "required_for_macos": [
    "apps/polar-station-macos/Resources/PolarStation.icns",
    "apps/polar-station-macos/Resources/PolarStationStatusTemplate.png",
    "apps/polar-station-macos/Resources/PolarStationStatusTemplate@2x.png"
  ],
  "export_assets": {
    "licenses/pinned": "automation/polar_station/public_assets/licenses/pinned",
    "licenses/pinned-evidence.json": "automation/polar_station/public_assets/licenses/pinned-evidence.json",
    "BUILD_MACOS.md": "automation/polar_station/public_assets/BUILD_MACOS.md",
    "docs/release/PUBLIC_PROFILE.md": "automation/polar_station/public_assets/docs/release/PUBLIC_PROFILE.md",
    "docs/release/ASSET_PROVENANCE.json": "automation/polar_station/public_assets/docs/release/ASSET_PROVENANCE.json",
    "licenses/cargo-evidence.json": "automation/polar_station/public_assets/licenses/cargo-evidence.json",
    "licenses/cargo-texts": "automation/polar_station/public_assets/licenses/cargo-texts",
    "licenses/mpl-source-inventory.json": "automation/polar_station/public_assets/licenses/mpl-source-inventory.json",
    "licenses/third-party-policy.json": "automation/polar_station/public_assets/licenses/third-party-policy.json",
    "licenses/cargo-archive-integrity.json": "automation/polar_station/public_assets/licenses/cargo-archive-integrity.json",
    "SOURCE_DISTRIBUTION.md": "automation/polar_station/public_assets/SOURCE_DISTRIBUTION.md",
    "SYNC_PUBLIC_REPO.md": "automation/polar_station/public_assets/SYNC_PUBLIC_REPO.md",
    "licenses/native-source-evidence.json": "automation/polar_station/public_assets/licenses/native-source-evidence.json",
    "licenses/native-source-texts": "automation/polar_station/public_assets/licenses/native-source-texts",
    "docs/release/NATIVE_BINARY_AUDIT.md": "automation/polar_station/public_assets/docs/release/NATIVE_BINARY_AUDIT.md",
    "LICENSE": "automation/polar_station/public_assets/LICENSE"
  }
}
